# Supabase — chave pública, segura para o navegador. NUNCA colocar a
# service role key aqui nem em nenhuma variável NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — service role key. Só usada em código server-only
# (lib/supabase/service.ts): confirmação autoritativa de pagamento a partir
# do webhook. Nunca expor ao cliente, nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — seleciona explicitamente o provider de pagamento.
# "mock": nunca chama o Mercado Pago (checkout simulado, nasce "pending").
# "mercadopago": usa a integração real abaixo.
# Deixar em branco também funciona: cai em "mercadopago" se
# MERCADOPAGO_ACCESS_TOKEN estiver definido, senão cai em "mock" — a
# ausência de credenciais nunca derruba a aplicação.
PAYMENT_PROVIDER=

# Mercado Pago — access token da conta ÚNICA do Jobê (não é o token de
# nenhum criador — não há OAuth nem conta por criador, todo pagamento cai
# nesta conta). Painel > Suas integrações > Credenciais de produção ou de
# teste (TEST-...).
MERCADOPAGO_ACCESS_TOKEN=

# Segredo da assinatura do webhook (painel do Mercado Pago > Webhooks).
# Opcional em dev, recomendado em produção para validar notificações.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do app, usada para montar back_urls e notification_url
# (ex.: https://app.onlyyou.com ou a URL do preview).
NEXT_PUBLIC_APP_URL=http://localhost:3000

MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_KEY=
