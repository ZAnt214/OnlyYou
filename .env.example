# Supabase — chave pública, segura para o navegador. NUNCA colocar a
# service role key aqui nem em nenhuma variável NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — service role key. Só usada em código server-only
# (lib/supabase/service.ts): tokens OAuth do Mercado Pago e confirmação
# autoritativa de pagamento. Nunca expor ao cliente, nunca prefixar com
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — seleciona explicitamente o provider de pagamento.
# "mock": nunca chama o Mercado Pago (checkout simulado, nasce "pending").
# "mercadopago": usa a integração real abaixo.
# Deixar em branco também funciona: cai em "mercadopago" se
# MERCADOPAGO_ACCESS_TOKEN estiver definido, senão cai em "mock" — a
# ausência de credenciais nunca derruba a aplicação.
PAYMENT_PROVIDER=

# Mercado Pago — credenciais OAuth da aplicação (marketplace). Criadas em
# https://www.mercadopago.com.br/developers/panel/app > sua aplicação >
# OAuth. Nunca expor como NEXT_PUBLIC_*.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# URL de callback cadastrada na aplicação do Mercado Pago, ex.:
# https://app.onlyyou.com/api/mercadopago/oauth/callback
MERCADOPAGO_REDIRECT_URI=

# Mercado Pago — access token da PRÓPRIA aplicação integradora (não é o
# token de nenhum criador). Usado para consultar pagamentos criados pelas
# contas conectadas via OAuth (webhook, status, refund). Painel > Suas
# integrações > Credenciais de produção ou de teste (TEST-...).
MERCADOPAGO_ACCESS_TOKEN=

# Segredo da assinatura do webhook (painel do Mercado Pago > Webhooks).
# Opcional em dev, recomendado em produção para validar notificações.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do app, usada para montar back_urls, notification_url e o
# redirect_uri do fluxo OAuth (ex.: https://app.onlyyou.com ou a URL do
# preview).
NEXT_PUBLIC_APP_URL=http://localhost:3000

MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_KEY=

# Segredo do servidor usado para assinar o "state" do OAuth do Mercado Pago
# (HMAC, evita CSRF/replay) — qualquer valor aleatório longo serve.
AUTH_SECRET=
