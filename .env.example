# Supabase Auth (criação de conta / login) — chaves públicas, seguras para
# o navegador. NUNCA colocar a service role key aqui nem em nenhuma
# variável NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mercado Pago — access token da conta vendedora (produção ou sandbox
# TEST-...). Nunca expor como NEXT_PUBLIC_*: só é usado em API routes
# (app/api/mercadopago/*), nunca no navegador.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook (painel do Mercado Pago > Webhooks).
# Opcional em dev, recomendado em produção para validar notificações.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do app, usada para montar back_urls e notification_url do
# Mercado Pago (ex.: https://app.onlyyou.com ou a URL do preview).
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_KEY=
AUTH_SECRET=
AGE_VERIFICATION_API_KEY=
